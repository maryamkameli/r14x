+    def _target_loglik(self, gen_batch, off_policy_targets, target_source_list, n, num_prompts):
+        """{prompt: {target: mean token log p_theta(target | prompt)}} for all teacher traces, current policy."""
+        from verl.protocol import pad_dataproto_to_divisor, unpad_dataproto
+        base = gen_batch.select(batch_keys=['input_ids', 'attention_mask', 'position_ids'], non_tensor_batch_keys=['raw_prompt_ids'])
+        prompts, resp, owner = [], [], []
+        for i in range(num_prompts):
+            s, k = i * n, len(target_source_list[i * n])
+            prompts.append(base.slice(s, s + 1).repeat(repeat_times=k, interleave=True))
+            resp.append(off_policy_targets[s][:k].clone())
+            owner += [(i, t) for t in range(k)]
+        batch = self.construct_off_policy_gen_batch(response=torch.cat(resp), prompts=DataProto.concat(prompts), batch_size=len(owner))
+        padded, pad = pad_dataproto_to_divisor(batch, self.actor_rollout_wg.world_size)
+        lp = unpad_dataproto(self.actor_rollout_wg.compute_log_prob(padded), pad).batch['old_log_probs']
+        mask = batch.batch['attention_mask'][:, -lp.shape[-1]:].float()
+        mean = ((lp * mask).sum(-1) / mask.sum(-1).clamp(min=1)).tolist()
+        out = defaultdict(dict)
+        for (i, t), v in zip(owner, mean):
+            out[i][t] = v
+        return out
+
