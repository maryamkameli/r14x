+_ANSWER_TAG = re.compile(r'<answer>(.*?)</answer>', re.DOTALL)
+
+def reward_fn_math_verify_v4(solution_str: str, ground_truth: str):
+    """R1x4 reward v4 (r1x4kit verl/r1x4/reward.py grade_one), used for training and validation of every baseline:
+    math_verify(parse('$gold$'), parse(whole response)), 0/1, no format term. <answer>X</answer> is rewritten to
+    \\boxed{X} first so a tagged plain number is graded like a boxed one."""
+    text = _ANSWER_TAG.sub(lambda m: '\\boxed{' + m.group(1).strip() + '}', solution_str)
+    try:
+        g = parse('$' + str(ground_truth) + '$', parsing_timeout=5)
+        return float(bool(verify(g, parse(text, parsing_timeout=5), timeout_seconds=5)))
+    except Exception:
+        return 0.0
+
