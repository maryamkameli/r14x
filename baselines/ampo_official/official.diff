-MODEL_PATH="/path/to/Qwen2.5-7B-Instruct"
-CKPTS_DIR="${HOME}/Qwen2.5-7B-Ins/checkpoints/${project_name}/${exp_name}"
-TRAIN_FILE="${HOME}/data/openr1_math_4longcots.parquet"
-TEST_FILE="${HOME}/data/valid.parquet"
+MODEL_PATH=Qwen/Qwen3-0.6B
+CKPTS_DIR="${ROOT}/r1x4_runs/baselines/ckpt/${exp_name}"
+TRAIN_FILE="${ROOT}/r1x4_runs/data/ampo/openr1_math_4longcots.parquet"
+TEST_FILE="${TEST_FILE:-${AHOME}/data/valid.parquet}"
 
 # MIX 
 num_off_policy_targets=2
@@ -58,13 +57,13 @@
 
 loss_agg_mode="token-mean"
 
-train_prompt_bsz=128
