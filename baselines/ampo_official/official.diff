 infer_ppo_max_token_len=$(((max_prompt_length + max_response_length) * 2))
 
-offload=True
-gen_tp=2
+offload=${OFFLOAD:-False}
+gen_tp=${GEN_TP:-1}
 fsdp_size=-1
 
 use_kl_in_reward=False
@@ -93,7 +92,7 @@
 kl_loss_coef=0.0
 
