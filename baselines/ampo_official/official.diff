-CUDA_VISIBLE_DEVICES=0,1,2,3 python3 -m verl.adaptive_mix_src.main_mix_dapo \
+python3 -m verl.adaptive_mix_src.main_mix_dapo \
     algorithm.adv_estimator=${adv_estimator} \
